# ----- Core -----
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fieldio
# Generate each with `openssl rand -hex 32`. In production the API refuses to
# start if either contains "change"/"secret"/"example" or if they are equal.
JWT_SECRET=CHANGE-ME-generate-a-64-char-random-secret-openssl-rand-hex-32
JWT_REFRESH_SECRET=CHANGE-ME-generate-a-64-char-refresh-secret-openssl-rand-hex32
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
# Max JSON/urlencoded request body size.
API_BODY_LIMIT=2mb

# Reverse proxy hops to trust for client IPs (rate limiting, audit logs).
#   false / 0 / unset → trust none (direct exposure)
#   true              → 1 hop (a single load balancer / nginx) — NOT trust-all
#   <n>               → n hops (e.g. 2 for Cloudflare → nginx)
#   loopback, 10.0.0.0/8, … → passed to Express as-is
TRUST_PROXY=false

# Server process timezone. Customer messages, PDFs and "today"/"this week"
# boundaries use each company's Settings → Regional timezone (default
# Africa/Johannesburg), so this only affects logs. Keep the host on UTC.
TZ=UTC

# Development only: set to true to disable API rate limiting (ignored in production).
DISABLE_RATE_LIMIT=false

# Public self-registration (POST /auth/register, the marketing "free trial" flow).
# OFF by default: only "true" or "1" opens it. When off, registration returns 403
# and accounts are created by an admin from Settings → Team.
ALLOW_PUBLIC_REGISTRATION=false

# Log every Prisma query (noisy; debugging only).
PRISMA_LOG_QUERIES=false

# ----- Database seeding (DESTRUCTIVE) -----
# `npm run db:seed` wipes every table. It refuses to run when NODE_ENV=production
# or DATABASE_URL points anywhere but localhost/127.0.0.1/::1/postgres, unless
# this is set to exactly `yes-wipe-<database name>` (e.g. yes-wipe-fieldio).
# Use `npm run db:deploy` (prisma migrate deploy) for production databases.
# ALLOW_DESTRUCTIVE_SEED=

# ----- Stripe (payments) -----
# Get from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# After running `stripe listen --forward-to localhost:3001/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=

# ----- Email (Resend) -----
# https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM="Fieldio <noreply@yourdomain.com>"

# ----- SMS (Twilio) -----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15555555555
# Optional: public base URL Twilio signs webhooks against, if it differs from API_URL
# TWILIO_WEBHOOK_BASE_URL=https://api.example.co.za

# ----- WhatsApp Business (Meta Cloud API) -----
# From developers.facebook.com → your app → WhatsApp → API setup.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any random string; must match the verify token configured on the Meta webhook.
WHATSAPP_VERIFY_TOKEN=

# ----- Web Push (job alerts on techs' phones) -----
# Generate a key pair once with `npx web-push generate-vapid-keys` and paste it
# here. Leave blank to disable push (in-app + socket alerts still work).
# VAPID_SUBJECT is a contact for push services: mailto:you@domain or https://domain.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@yourdomain.com

# ----- Google reviews -----
# Hours after job completion before the review request is sent.
GOOGLE_REVIEW_DELAY_HOURS=2

# ----- Object storage (S3 or Cloudflare R2) -----
# For R2: set S3_ENDPOINT to https://<accountid>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# ----- Maps -----
MAPBOX_TOKEN=
NEXT_PUBLIC_MAPBOX_TOKEN=

# ----- Web app -----
NEXT_PUBLIC_API_URL=http://localhost:3001
